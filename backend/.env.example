MONGO_URI=aapka_url
DATABASE_NAME=lumen_db
JWT_SECRET_KEY="replace_this_with_a_long_random_string"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Kilo gateway (primary text generation) ──────────────────────────────────
# The free models work without a key. Set KILO_API_KEY to raise the rate limit.
KILO_API_BASE=https://api.kilo.ai/api/gateway
KILO_API_KEY=
KILO_MODELS=poolside/laguna-s-2.1:free,poolside/laguna-xs-2.1:free,minimax/minimax-m3.1-flash:free,nvidia/nemotron-3.5-lightning:free
KILO_TIMEOUT=120

# ── NVIDIA NIM (embeddings) ──────────────────────────────────────────────────
# The Kilo gateway does not serve an embedding model, so vectors come from
# NVIDIA NIM. Get a key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-aapka_key
NVIDIA_EMBEDDING_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# ── Gemini (fallback only) ───────────────────────────────────────────────────
# Only used if the Kilo gateway cannot serve a request.
GEMINI_API_KEY=aapka_key
GEMINI_API_KEY_2=aapka_key2
GEMINI_MODELS=gemini-2.5-flash,gemini-3.8-flash,gemini-3.5-flash,gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODELS=gemini-embedding-001,gemini-embedding-2

YOUTUBE_API_KEY=aapka_yt_key
GROQ_API_KEY=aapka_groq_key
